# Values baked into the claude.ai upload zip by:  npm run skill:zip:claude-ai
#
# Only the STAGED copy is rewritten — the source SKILL.md keeps its Claude Code
# defaults (localhost endpoint, ~/.claude/skills paths), so the skill still
# works in this Claude Code session directly. Each var below replaces a literal
# in the staged copy (see RULES in scripts/pack-skill.mjs).

# Endpoint the skill defaults to when $ANNOTATED_MCP_ENDPOINT isn't set at
# runtime. Replaces the local default http://127.0.0.1:27191.
# Use the public proxy URL: TLS on 443, NO :27191 — the Annotated server speaks
# plain HTTP internally and the reverse proxy terminates TLS and forwards to it.
ANNOTATED_MCP_ENDPOINT=https://mcp-obsidian.dmetr.io

# Where the bundled monitor scripts are referenced from. Replaces the Claude Code
# path prefix ~/.claude/skills/watch-vault. On claude.ai the bundled files
# extract alongside SKILL.md, so a path relative to the skill folder is correct.
SKILL_BASE_DIR=watch-vault

# NOTE: the poll key is NOT set here. It is read from the SHELL env var
# $ANNOTATED_WATCH_KEY at build time and baked into the staged scripts (redacted
# in logs) — so no secret lives in this committed file. Run:
#   ANNOTATED_WATCH_KEY=ann_poll_… npm run skill:zip:claude-ai
# The resulting dist/watch-vault.claude-ai.zip then contains a live read key —
# treat it as a secret; rotate by re-minting the key and rebuilding.
