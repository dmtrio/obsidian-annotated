{
  "name": "obsidian-annotated",
  "version": "0.1.5",
  "description": "Code review-style comments for Obsidian notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:lite": "node esbuild.config.mjs production-lite",
    "dist": "node esbuild.config.mjs production && mkdir -p dist/obsidian-annotated && cp main.js manifest.json styles.css dist/obsidian-annotated/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "moment": "^2.30.1",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@annotated/comments-core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
